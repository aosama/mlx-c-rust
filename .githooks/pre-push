#!/usr/bin/env sh

set -eu

REPOSITORY_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    printf '%s\n' '[pre-push] status=failed reason=not-a-git-worktree' >&2
    exit 1
}

# Every push triggers a paid GitHub Actions round trip; a failure that one
# local verification would have caught wastes that money and several
# minutes of wall clock. Gate the push on the same lint lane the runner
# runs. MLX_C_RUST_SKIP_PRE_PUSH=1 escapes deliberately, for example when
# pushing a branch whose failures are the subject under test.
if [ "${MLX_C_RUST_SKIP_PRE_PUSH:-0}" = "1" ]; then
    printf '%s\n' '[pre-push] status=skipped reason=MLX_C_RUST_SKIP_PRE_PUSH=1'
    exit 0
fi

printf '%s\n' "[pre-push] status=start check=verify root=${REPOSITORY_ROOT}"
started_epoch_seconds="$(date +%s)"
# The manifest path pins the build to this checkout's xtask; the verify
# command runs the size ceiling, formatting, clippy, and documentation
# lanes from typed Rust, so this shim only reports and relays the verdict.
if (cd "${REPOSITORY_ROOT}" && cargo run --quiet --manifest-path "${REPOSITORY_ROOT}/xtask/Cargo.toml" -p xtask -- verify); then
    elapsed_seconds=$(( $(date +%s) - started_epoch_seconds ))
    printf '%s\n' "[pre-push] status=success check=verify elapsed_seconds=${elapsed_seconds}"
    exit 0
fi
elapsed_seconds=$(( $(date +%s) - started_epoch_seconds ))
printf '%s\n' "[pre-push] status=failed check=verify elapsed_seconds=${elapsed_seconds}" >&2
printf '%s\n' '[pre-push] hint=fix the failures locally before spending a GitHub Actions run' >&2
exit 1
